# Your Croma API key: https://platform.usecroma.com
CROMA_API_KEY=

# Optional, for a public deploy: limits station and route lookups per IP
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcional: publica los reportes como issues en GitHub.
# Token fine-grained con permiso Issues: Read and write solo sobre el repo.
# https://github.com/settings/personal-access-tokens/new
GITHUB_REPORTS_TOKEN=

# Opcional: repo destino de los reportes (por defecto yanzes/TransmiRuta).
REPORTS_REPO=

# Opcional: otro feed GTFS-Realtime de posiciones.
# Por defecto https://gtfs.transmilenio.gov.co/positions.pb
GTFS_RT_URL=
