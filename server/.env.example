# Official TransMilenio VehiclePositions feed (protobuf, FULL_DATASET).
GTFS_RT_URL=https://gtfs.transmilenio.gov.co/positions.pb

# live = poll the feed above. mock = synthetic buses, same protobuf pipeline.
FEED_SOURCE=live

PORT=8787

# Where the map is served from (comma separated). Vite dev server by default.
CLIENT_ORIGIN=http://localhost:5173

# Polling and cache behaviour.
POLL_INTERVAL_MS=10000
FEED_TIMEOUT_MS=8000
MAX_BACKOFF_MS=60000
STALE_AFTER_MS=45000

# Route catalog built by `npm run sync:routes` (F23 -> numeric route_id).
ROUTES_FILE=data/routes.json
