{
  "name": "@transmi/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GTFS-Realtime gateway for TransMilenio: polls the official protobuf feed, filters by route and fans it out over Socket.io.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "probe": "tsx scripts/probe-feed.ts",
    "sync:routes": "tsx scripts/sync-gtfs.ts",
    "sync:stops": "tsx scripts/sync-stops.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "fflate": "^0.8.3",
    "gtfs-realtime-bindings": "^1.1.1",
    "socket.io": "^4.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
