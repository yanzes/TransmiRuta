{
  "name": "@transmi/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mapa en vivo de TransMilenio: busca una ruta y mira sus buses moverse sobre Bogotá.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-ws.mjs",
    "icons": "node scripts/make-icons.mjs",
    "brand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-brand.ps1"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
